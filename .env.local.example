# ================================================================
# FiTDOOR Trainer App — 환경변수 설정 가이드
# cp .env.local.example .env.local 후 값을 채워주세요
# ⚠️  .env.local은 절대 git에 커밋하지 마세요
# ================================================================

# ─── 파일 구조 (dev/prod 격리) ────────────────────────────────────
#  .env.local        dev Supabase + 공용 키.
#                    Next.js 가 자동 로드하는 기본 파일 = 앱은 항상 dev 를 본다.
#  .env.prod.local   prod Supabase 3키 전용.
#                    Next.js 가 인식하지 않는 파일명이라 앱은 이 파일을 로드하지 않는다.
#                    콘텐츠 스크립트가 KINEPIA_TARGET=prod 일 때만 읽는다.
#
#  콘텐츠 스크립트(scripts/) 실행법
#    dev (기본)      node scripts/xxx.js
#    prod            KINEPIA_TARGET=prod node scripts/xxx.js --confirm-prod
#                    --confirm-prod 가 없으면 에러와 함께 중단한다(exit 1).
#    대상 확인만     node scripts/xxx.js --dry-run
#                    로드한 env 파일과 대상 project ref 만 출력하고 종료(exit 0).
#                    DB·Storage 에 접근하지 않는다.
#
#  세 스크립트 모두 실행 시작 시 대상 project ref 를 stdout 에 출력한다.
#  실행 전 그 값이 의도한 환경인지 반드시 눈으로 확인할 것.

# ─── Supabase (서버 전용 — NEXT_PUBLIC_ 최소화) ───────────────────
# Supabase 대시보드 > Settings > API에서 확인
# 아래 3키는 dev 값을 .env.local 에, prod 값을 .env.prod.local 에 둔다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service Role Key는 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── NextAuth ─────────────────────────────────────────────────────
# 랜덤 시크릿 생성: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000
# 운영 환경:
# NEXTAUTH_URL=https://kinepia-rho.vercel.app

# ─── Google OAuth 2.0 ─────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Kakao OAuth 2.0 ──────────────────────────────────────────────
# https://developers.kakao.com > 내 애플리케이션 > 앱 설정 > 앱 키
# REST API 키를 KAKAO_CLIENT_ID에 입력
KAKAO_CLIENT_ID=your-kakao-rest-api-key
# 카카오 로그인 > 보안 > Client Secret (선택 사항, 활성화 시 입력)
KAKAO_CLIENT_SECRET=your-kakao-client-secret
# Redirect URI 등록 필요:
# https://kinepia-rho.vercel.app/api/auth/callback/kakao
# http://localhost:3000/api/auth/callback/kakao

# ─── 암호화 키 (서버 전용 — 절대 NEXT_PUBLIC_ 붙이지 말 것) ──────
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# ─── 해시 솔트 (서버 전용) ────────────────────────────────────────
HASH_SALT=your-random-hash-salt

# ─── 앱 URL ───────────────────────────────────────────────────────
# .env.local 은 dev 전용 파일이므로 로컬에서는 http://localhost:3000 을 쓴다.
# 운영 도메인은 배포 플랫폼(Vercel)의 환경변수에서 관리한다.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── 광고 설정 ───────────────────────────────────────────────────
# internal: ad_banners 테이블 광고 (개발/MVP)
# adsense:  Google AdSense (배포 후)
NEXT_PUBLIC_AD_MODE=internal

# Google AdSense (NEXT_PUBLIC_AD_MODE=adsense 시 필요)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT=XXXXXXXXXX

# ─── Phase 2 (현재 미사용) ────────────────────────────────────────
# NEXT_PUBLIC_ENABLE_PHASE2=false
